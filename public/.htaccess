# DissertlyPro Apache/LiteSpeed Configuration for cPanel
# Enables SPA routing, caching, compression, and security headers

# ============================================
# REWRITE ENGINE - SPA FALLBACK ROUTING
# ============================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectorySlash Off
  
  # Force HTTPS (uncomment when SSL is configured)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # ============================================
  # SEO PLAN §1 — Kill subdomain duplication
  # 301-redirect every us./uk./au./ca. subdomain to the canonical root.
  # This consolidates link equity and ends the keyword cannibalization
  # flagged in the Semrush audit (same content ranking twice).
  # ============================================
  # ORDER PORTAL — legacy order/checkout URLs on any host go straight to the cPanel portal
  RewriteRule ^(order|order/.*|quick-checkout|quick-checkout/.*|checkout|quick-services/checkout)/?$ https://dissertlypro.com/orders/stud/new [L,R=301,QSD]
  RewriteRule ^login/?$ https://dissertlypro.com/orders/login [L,R=301,QSD]

  # Let the cPanel order portal (/orders/) handle its own requests
  RewriteRule ^orders(/.*)?$ - [L]

  RewriteCond %{HTTP_HOST} ^(us|uk|au|ca)\.dissertlypro\.com$ [NC]
  RewriteRule ^(.*)$ https://dissertlypro.com/$1 [L,R=301,NE]
  
  # Remove www (canonical = non-www)
  RewriteCond %{HTTP_HOST} ^www\.dissertlypro\.com$ [NC]
  RewriteRule ^(.*)$ https://dissertlypro.com/$1 [L,R=301,NE]
  
  # GSC SOFT-404 RECOVERY — retired URLs → closest live page (single hop)
  RewriteRule ^adelaide-assignment-help/?$ https://dissertlypro.com/au [L,R=301,QSD]
  RewriteRule ^curtin-assignment-help/?$ https://dissertlypro.com/au [L,R=301,QSD]
  RewriteRule ^unsw-assignment-help/?$ https://dissertlypro.com/au/unsw [L,R=301,QSD]
  RewriteRule ^uq-assignment-help/?$ https://dissertlypro.com/au/queensland [L,R=301,QSD]
  RewriteRule ^usyd-assignment-help/?$ https://dissertlypro.com/au/sydney [L,R=301,QSD]
  RewriteRule ^uts-assignment-help/?$ https://dissertlypro.com/au [L,R=301,QSD]
  RewriteRule ^aglc4-referencing-guide/?$ https://dissertlypro.com/citation-mastery [L,R=301,QSD]
  RewriteRule ^macquarie-referencing-guide/?$ https://dissertlypro.com/citation-mastery [L,R=301,QSD]
  RewriteRule ^rmit-referencing-guide/?$ https://dissertlypro.com/citation-mastery [L,R=301,QSD]
  RewriteRule ^unsw-referencing-guide/?$ https://dissertlypro.com/citation-mastery [L,R=301,QSD]
  RewriteRule ^uts-referencing-guide/?$ https://dissertlypro.com/citation-mastery [L,R=301,QSD]
  RewriteRule ^biology-assignment-help/?$ https://dissertlypro.com/subjects [L,R=301,QSD]
  RewriteRule ^physics-assignment-help/?$ https://dissertlypro.com/subjects [L,R=301,QSD]
  RewriteRule ^sociology-assignment-help/?$ https://dissertlypro.com/subjects [L,R=301,QSD]
  RewriteRule ^finance-assignment-help/?$ https://dissertlypro.com/subjects [L,R=301,QSD]
  RewriteRule ^data-analytics-assignment-help/?$ https://dissertlypro.com/dissertation-statistics-help [L,R=301,QSD]
  RewriteRule ^capstone-project-help/?$ https://dissertlypro.com/capstone-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^data-collection-analysis/?$ https://dissertlypro.com/services/data-analysis [L,R=301,QSD]
  RewriteRule ^do-my-dissertation/?$ https://dissertlypro.com/dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^do-my-essay/?$ https://dissertlypro.com/dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^pay-someone-to-write-my-assignment/?$ https://dissertlypro.com/dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^how-to-write-a-literature-review-australia/?$ https://dissertlypro.com/literature-review-guide [L,R=301,QSD]
  RewriteRule ^hrec-ethics-application-guide/?$ https://dissertlypro.com/irb-ethics-guide [L,R=301,QSD]
  RewriteRule ^privacy-policy/?$ https://dissertlypro.com/privacy [L,R=301,QSD]
  RewriteRule ^refund-policy/?$ https://dissertlypro.com/terms [L,R=301,QSD]
  RewriteRule ^terms-and-conditions/?$ https://dissertlypro.com/terms [L,R=301,QSD]
  RewriteRule ^ca/uoft/?$ https://dissertlypro.com/ca/toronto [L,R=301,QSD]
  RewriteRule ^services/academic-editing/?$ https://dissertlypro.com/services/editing [L,R=301,QSD]
  RewriteRule ^services/capstone-dissertation-writing-services/?$ https://dissertlypro.com/capstone-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^services/cheap-dissertation-writing-services/?$ https://dissertlypro.com/cheap-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^services/dissertation-proposal-writing-services/?$ https://dissertlypro.com/dissertation-proposal-writing-services [L,R=301,QSD]
  RewriteRule ^services/dissertation-writing/?$ https://dissertlypro.com/dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^services/online-dissertation-writing-services/?$ https://dissertlypro.com/online-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^services/proposal-development/?$ https://dissertlypro.com/services/dissertation-proposal [L,R=301,QSD]
  RewriteRule ^services/research-methodology/?$ https://dissertlypro.com/services/methodology [L,R=301,QSD]
  RewriteRule ^services/masters-dissertation-writing-services/?$ https://dissertlypro.com/masters-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^services/medical-dissertation-writing-services/?$ https://dissertlypro.com/medical-dissertation-writing-services [L,R=301,QSD]
  RewriteRule ^case-studies/distinction-masters-dissertation-uq-nursing/?$ https://dissertlypro.com/blog [L,R=301,QSD]
  RewriteRule ^case-studies/engineering-thesis-unsw-fatigue-hd/?$ https://dissertlypro.com/blog [L,R=301,QSD]
  RewriteRule ^case-studies/mba-capstone-monash-strategy-hd/?$ https://dissertlypro.com/blog [L,R=301,QSD]
  RewriteRule ^blog/harvard-dissertation-requirements/?$ https://dissertlypro.com/blog/harvard-dissertation-requirements-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/mit-thesis-writing-strategies/?$ https://dissertlypro.com/blog/mit-thesis-requirements-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/stanford-dissertation-excellence/?$ https://dissertlypro.com/blog/stanford-dissertation-guide-requirements-process [L,R=301,QSD]
  RewriteRule ^blog/ai-thesis-writing-guide/?$ https://dissertlypro.com/blog/can-i-use-chatgpt-for-dissertation-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/using-ai-tools-ethically-australian-thesis/?$ https://dissertlypro.com/blog/can-i-use-chatgpt-for-dissertation-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/dissertation-discussion-chapter-example/?$ https://dissertlypro.com/dissertation-findings-chapter [L,R=301,QSD]
  RewriteRule ^blog/dissertation-results-section-example/?$ https://dissertlypro.com/dissertation-findings-chapter [L,R=301,QSD]
  RewriteRule ^blog/findings-vs-discussion-difference/?$ https://dissertlypro.com/dissertation-findings-chapter [L,R=301,QSD]
  RewriteRule ^blog/literature-review-tips-australian-thesis/?$ https://dissertlypro.com/blog/how-to-write-literature-review-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/systematic-review-methodology-australian-thesis/?$ https://dissertlypro.com/blog/systematic-literature-review-methodology-prisma [L,R=301,QSD]
  RewriteRule ^blog/survey-design-tips-postgraduate-research/?$ https://dissertlypro.com/blog/research-methodology-types-examples-guide [L,R=301,QSD]
  RewriteRule ^blog/post-phd-career-options-australia/?$ https://dissertlypro.com/blog/career-options-after-phd [L,R=301,QSD]
  RewriteRule ^blog/time-management-postgraduate-students-australia/?$ https://dissertlypro.com/blog/write-dissertation-faster-productivity-tips [L,R=301,QSD]
  RewriteRule ^blog/viva-voce-examination-australian-universities/?$ https://dissertlypro.com/viva-preparation [L,R=301,QSD]
  RewriteRule ^blog/international-students-thesis-guide-australia/?$ https://dissertlypro.com/international-students [L,R=301,QSD]
  RewriteRule ^blog/research-training-program-rtp-guide-australia/?$ https://dissertlypro.com/phd-funding [L,R=301,QSD]
  RewriteRule ^blog/abstract-writing-guide-australian-thesis/?$ https://dissertlypro.com/blog/how-to-write-dissertation-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/data-management-plan-australian-research/?$ https://dissertlypro.com/research-methodology [L,R=301,QSD]
  RewriteRule ^blog/how-to-write-first-class-honours-thesis-australia/?$ https://dissertlypro.com/blog/how-to-write-dissertation-complete-guide [L,R=301,QSD]
  RewriteRule ^blog/understanding-australian-grading-system-postgraduate/?$ https://dissertlypro.com/au [L,R=301,QSD]

  # Trailing slash: /page/ → /page (one hop, keeps query string)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ https://dissertlypro.com/$1 [L,R=301]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://dissertlypro.com/$1 [L,R=301]

  # Serve prerendered /page/index.html for /page without a slash redirect
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Handle React Router - serve index.html for all non-file requests
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ============================================
# COMPRESSION - GZIP/BROTLI
# ============================================
<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  
  # Remove browser bugs (only needed for ancient browsers)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

# ============================================
# BROWSER CACHING - EXPIRES HEADERS
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default expiration: 1 month
  ExpiresDefault "access plus 1 month"
  
  # HTML - short cache (changes frequently)
  ExpiresByType text/html "access plus 0 seconds"
  
  # Data files - short cache
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/ld+json "access plus 1 day"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  
  # CSS and JavaScript - long cache (hashed by Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Images - long cache
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  
  # Fonts - long cache
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/eot "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  
  # Manifest and service worker
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/cache-manifest "access plus 0 seconds"
</IfModule>

# ============================================
# CACHE-CONTROL HEADERS
# ============================================
<IfModule mod_headers.c>
  # index.html - no cache (SPA entry point)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # SEO files - short cache
  <FilesMatch "\.(xml|txt|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  
  # Sitemap - 1 hour cache
  <FilesMatch "sitemap\.xml$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  
  # Static assets in /assets - immutable (Vite hashes these)
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Images - long cache
  <FilesMatch "\.(ico|gif|jpg|jpeg|png|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Clickjacking protection
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # XSS Protection (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy (formerly Feature-Policy)
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  
  # HSTS - Strict Transport Security (uncomment after SSL is confirmed working)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ============================================
# MIME TYPES
# ============================================
<IfModule mod_mime.c>
  # JavaScript
  AddType application/javascript js mjs
  
  # JSON
  AddType application/json json
  AddType application/ld+json jsonld
  
  # Fonts
  AddType font/woff woff
  AddType font/woff2 woff2
  AddType font/ttf ttf
  AddType font/otf otf
  AddType application/vnd.ms-fontobject eot
  
  # Images
  AddType image/webp webp
  AddType image/avif avif
  AddType image/svg+xml svg svgz
  
  # Manifest
  AddType application/manifest+json webmanifest
  
  # Text
  AddType text/plain txt
  AddType text/xml xml
</IfModule>

# ============================================
# PREVENT HOTLINKING (optional - uncomment to enable)
# ============================================
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_REFERER} !^$
#   RewriteCond %{HTTP_REFERER} !^https?://(www\.)?dissertlypro\.com [NC]
#   RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC,L]
# </IfModule>

# ============================================
# ERROR DOCUMENTS
# ============================================
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html

# ============================================
# DISABLE DIRECTORY BROWSING
# ============================================
Options -Indexes

# ============================================
# BLOCK SENSITIVE FILES
# ============================================
<FilesMatch "(^\.htaccess|\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>
